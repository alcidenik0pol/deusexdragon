{
    "compilerOptions": {
      "outDir": "./dist/",
      "sourceMap": true,
      "noImplicitAny": false,
      "module": "commonjs",
      "target": "es5",
      "jsx": "react",
      "allowJs": true,
      "moduleResolution": "node",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "lib": ["dom", "es2015", "es2016", "es2017"],
      "typeRoots": ["./types", "./node_modules/@types"]
    },
    "include": [
      "src/**/*",
      "types/**/*"
    ]
}